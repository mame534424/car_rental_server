NODE_ENV=development
PORT=4000

# Supabase Postgres connection strings
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# JWT secrets — generate strong random values, do not reuse across environments
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=id-documents

# Frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:4000

# Seed admin (change password after first login)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@lumencarrental.com
SEED_ADMIN_PASSWORD=admin123

# Only set in production (e.g. ".lumencarrental.com") to share cookies across subdomains
COOKIE_DOMAIN=
